# Configuración de Variables de Entorno para Vercel
# Proyecto: Hotel Casino Noir - Despacho Automatizado de WhatsApp

# Número telefónico emisor del sistema (formato nacional o E.164)
SENDER_PHONE_NUMBER=04242083041

# Credenciales de Twilio (si se usa Twilio Messaging API para WhatsApp)
TWILIO_ACCOUNT_SID=AC_tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Credenciales de Meta Cloud API (si se usa la API oficial de Meta para WhatsApp)
WHATSAPP_CLOUD_API_TOKEN=EAAG_tu_token_permanente_aqui
WHATSAPP_PHONE_NUMBER_ID=04242083041
